# Optional build-time overrides. Defaults use OpenStreetMap / FOSSGIS.
# For confidential routes, point these at your own services before building.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
# Each endpoint must run the corresponding OSRM travel profile.
VITE_ROUTING_FOOT_URL=https://routing.openstreetmap.de/routed-foot
VITE_ROUTING_CAR_URL=https://routing.openstreetmap.de/routed-car
